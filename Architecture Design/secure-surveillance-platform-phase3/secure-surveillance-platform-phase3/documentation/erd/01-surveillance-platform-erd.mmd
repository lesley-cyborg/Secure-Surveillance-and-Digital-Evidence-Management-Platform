        uuid generated_by_user_id FK
        varchar report_type
        varchar title
        json filters
        varchar storage_object_key
        varchar file_format
        varchar report_sha256
        varchar digital_signature
        varchar status
        timestamp generated_at
        timestamp created_at
    }

    REPORT_INCIDENTS {
        uuid report_id PK, FK
        uuid incident_id PK, FK
    }

    REPORT_EXPORTS {
        uuid id PK
        uuid report_id FK
        uuid exported_by_user_id FK
        varchar export_format
        varchar storage_object_key
        varchar watermark_reference
        timestamp expires_at
        timestamp downloaded_at
        timestamp created_at
    }

