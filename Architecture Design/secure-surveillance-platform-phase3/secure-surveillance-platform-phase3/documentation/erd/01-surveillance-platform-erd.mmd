        uuid id PK
        uuid camera_id FK
        uuid ai_model_id FK
        json configuration
        decimal confidence_threshold
        boolean is_enabled
        timestamp created_at
        timestamp updated_at
    }

    INCIDENTS {
        uuid id PK
        varchar incident_number UK
        uuid primary_camera_id FK
        uuid created_by_user_id FK
        varchar source_type
        varchar incident_type
        varchar severity
        varchar priority
        varchar status
        varchar title
        text description
        varchar disposition
        timestamp detected_at
        timestamp confirmed_at
        timestamp closed_at
        timestamp created_at
        timestamp updated_at
    }

    DETECTION_EVENTS {
        uuid id PK
        uuid camera_id FK
        uuid ai_model_id FK
        uuid incident_id FK
        varchar event_type
        decimal confidence_score
        json bounding_boxes
        json recognition_results
        json ocr_results
        json contextual_metadata
        timestamp detected_at
        timestamp processed_at
        timestamp created_at
    }

