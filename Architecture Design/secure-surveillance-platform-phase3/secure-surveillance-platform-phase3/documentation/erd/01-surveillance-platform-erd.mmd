erDiagram
    USERS {
        uuid id PK
        varchar email UK
        varchar username UK
        varchar password_hash
        varchar first_name
        varchar last_name
        varchar phone
        boolean mfa_enabled
        boolean is_active
        int failed_login_attempts
        timestamp locked_until
        timestamp last_login_at
        timestamp created_at
        timestamp updated_at
        timestamp deleted_at
    }

    ROLES {
        uuid id PK
        varchar name UK
        varchar description
        boolean is_system_role
        timestamp created_at
        timestamp updated_at
    }

    PERMISSIONS {
        uuid id PK
        varchar code UK
        varchar resource
        varchar action
        varchar description
        timestamp created_at
    }

    USER_ROLES {
        uuid user_id PK, FK
        uuid role_id PK, FK
        uuid assigned_by FK
        timestamp assigned_at
        timestamp expires_at
    }

    ROLE_PERMISSIONS {
        uuid role_id PK, FK
        uuid permission_id PK, FK
        timestamp granted_at
    }

    AUTH_SESSIONS {
        uuid id PK
        uuid user_id FK
        varchar refresh_token_hash UK
        varchar token_jti UK
        varchar ip_address
        varchar user_agent
        timestamp expires_at
        timestamp revoked_at
        uuid replaced_by_session_id FK
        timestamp created_at
    }

    SITES {
        uuid id PK
        varchar name
        varchar address
        varchar latitude
        varchar longitude
        varchar timezone
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    CAMERAS {
        uuid id PK
        uuid site_id FK
        uuid registered_by FK
        varchar name
        varchar camera_code UK
        varchar ip_address
        varchar protocol
