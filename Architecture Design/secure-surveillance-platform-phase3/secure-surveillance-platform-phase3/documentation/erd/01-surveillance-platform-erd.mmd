        uuid id PK
        varchar name
        varchar model_type
        varchar version
        varchar framework
        varchar artifact_uri
        varchar checksum_sha256
        decimal confidence_threshold
        boolean is_active
        timestamp deployed_at
        timestamp created_at
    }

