APP_NAME=Secure Surveillance Platform API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://surveillance:surveillance@localhost:5432/surveillance
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=3

JWT_SECRET_KEY=rdtgrfuiulkgfvcfeaqstykipookwlexjukbxyejuaevhytwcrxtgw
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evidence

# AI-engine internal event ingestion
AI_INGESTION_ENABLED=false

# Generate separately. Never commit a real value.
AI_INGESTION_SERVICE_TOKEN=

AI_INGESTION_MAX_BODY_BYTES=1048576

# Evidence cryptography
EVIDENCE_WRAPPING_PUBLIC_KEY_PATH=.secrets/evidence/wrapping-public.pem
EVIDENCE_WRAPPING_PRIVATE_KEY_PATH=.secrets/evidence/wrapping-private.pem
EVIDENCE_WRAPPING_PRIVATE_KEY_PASSWORD=
EVIDENCE_WRAPPING_KEY_REFERENCE=local://evidence-wrapping/v1
EVIDENCE_WRAPPING_KEY_VERSION=1

EVIDENCE_SIGNING_PRIVATE_KEY_PATH=.secrets/evidence/signing-private.pem
EVIDENCE_SIGNING_PRIVATE_KEY_PASSWORD=
EVIDENCE_SIGNING_KEY_REFERENCE=local://evidence-signing/v1
EVIDENCE_SIGNING_KEY_VERSION=1